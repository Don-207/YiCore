# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/
/build*/

# Third-party and locally generated private-key artifacts
keys/*.pem
**/keys/*.pem
third_party/mcuboot-2.4.0/*.pem
third_party/mcuboot-2.4.0/*.b64
third_party/mcuboot-2.4.0/**/*.pem
third_party/mcuboot-2.4.0/**/*.b64

# YiCore generated DeviceTree sources
/generated/
**/generated/

# Local hardware debug captures
*.jlink
*.log

# Product host tools live in their own repositories.
/Tools/

# Pruned vendor content that is not part of the YiCore STM32 build.
/vendor/st/cmsis/DSP/Examples/
/vendor/st/cmsis/NN/Examples/
/vendor/st/cmsis/NN/NN_Lib_Tests/
/vendor/st/cmsis/Lib/IAR/
/vendor/st/cmsis/Lib/ARM/arm_cortexM3b_math.lib

# Keil build output and per-user settings
**/MDK-ARM/*/
**/MDK-ARM/*.log
**/MDK-ARM/*.htm
**/MDK-ARM/*.map
**/MDK-ARM/*.axf
**/MDK-ARM/*.hex
**/MDK-ARM/*.bin
**/MDK-ARM/*.o
**/MDK-ARM/*.d
**/MDK-ARM/*.dep
**/MDK-ARM/*.lnp
**/MDK-ARM/*.iex
**/MDK-ARM/*.uvoptx
**/MDK-ARM/*.uvguix.*
**/MDK-ARM/JLinkLog.txt
**/MDK-ARM/JLinkSettings.ini

# The old root Keil directory can be removed after uVision is closed.
/MDK-ARM/

# Editors, agents and operating-system metadata
/.agents/
/.vscode/
/.idea/
.DS_Store
Thumbs.db
